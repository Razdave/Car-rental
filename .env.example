# ---------------------------------------------------------------- Web app (Vite)
# Leave the Supabase values empty to run in device-only demo mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Public VAPID key for Web Push (generate with: npx web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=

# ---------------------------------------------------------------- Supabase Edge Function secrets
# Set with: supabase secrets set KEY=value   (never commit real values)
# SITE_URL=https://your-domain.example
# ALLOWED_ORIGINS=https://your-domain.example,http://localhost:3000
# PAYSTACK_SECRET_KEY=sk_test_...
# RESEND_API_KEY=re_...
# NOTIFY_FROM_EMAIL="Aurevon <bookings@your-domain.example>"
# TERMII_API_KEY=...
# TERMII_SENDER_ID=Aurevon
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...
# VAPID_SUBJECT=mailto:support@your-domain.example
# CRON_SECRET=a-long-random-string   (also stored in public.app_settings, see docs/SUPABASE_SETUP.md)

# ---------------------------------------------------------------- Legacy Express API (server/)
# API server
API_PORT=4000
API_HOST=127.0.0.1
DATABASE_PATH=./data/rental.sqlite
UPLOAD_DIR=./data/car-images
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
BOOTSTRAP_ADMIN_NAME=System Administrator

# Configure this with a strong random value before connecting a GPS provider.
GPS_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
